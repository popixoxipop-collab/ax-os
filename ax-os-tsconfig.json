{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "ax-os-dist",
    "rootDir": "ax-os-src",
    "lib": ["ES2022"],
    "types": ["node"],
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["ax-os-src/**/*"],
  "exclude": ["node_modules", "ax-os-dist", "ax-os-src/ax-os-example.ts"]
}