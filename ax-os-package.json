{
  "name": "ax-os",
  "version": "2.0.0",
  "description": "AX OS v2 — Multi-Agent OS on local LLMs (Ollama) + Claude API. ReAct, A2A delegation, vector memory, adaptive routing, BRAIN alpha search.",
  "type": "module",
  "main": "ax-os-dist/ax-os-index.js",
  "types": "ax-os-dist/ax-os-index.d.ts",
  "scripts": {
    "build": "tsc -p ax-os-tsconfig.json && echo '{\"type\":\"module\"}' > ax-os-dist/package.json",
    "dev": "tsc -p ax-os-tsconfig.json --watch",
    "test": "npm run build && node --test ax-os-tests/*.test.mjs",
    "test:nobuild": "node --test ax-os-tests/*.test.mjs",
    "verify": "node ax-os-verify-build.mjs",
    "typecheck": "tsc -p ax-os-tsconfig.json --noEmit"
  },
  "keywords": ["llm", "multi-agent", "ollama", "react", "agent-orchestration", "rag", "adaptive-routing"],
  "author": "Claude Code",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}